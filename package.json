{
  "name": "agua-lembrete",
  "version": "0.4.0",
  "description": "Lembrete de água e de bater o ponto, para quem tem rotina corrida",
  "private": true,
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "test": "electron . --test",
    "dist": "electron-builder --linux deb --win nsis --publish never",
    "dist:win": "electron-builder --win nsis --publish never"
  },
  "devDependencies": {
    "electron": "^45.2.3",
    "electron-builder": "^26.18.0"
  },
  "build": {
    "appId": "com.wesley.agua",
    "productName": "Água",
    "publish": {
      "provider": "github",
      "owner": "wesurex",
      "repo": "lembrete-agua"
    },
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "main.html",
      "alert.html",
      "tray.png",
      "package.json",
      "i18n.js"
    ],
    "linux": {
      "target": [
        "deb"
      ],
      "category": "Utility",
      "icon": "build/icon.png",
      "maintainer": "Wesley <agua@localhost>"
    },
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "runAfterFinish": false,
      "artifactName": "agua-setup-${version}.${ext}"
    }
  },
  "homepage": "https://localhost",
  "author": {
    "name": "Wesley",
    "email": "agua@localhost"
  },
  "dependencies": {
    "electron-updater": "^6.8.11"
  },
  "license": "MIT"
}
