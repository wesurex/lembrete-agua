{
  "name": "agua-lembrete",
  "version": "0.2.0",
  "description": "Lembrete recorrente para beber água (protótipo)",
  "private": true,
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "test": "electron . --test",
    "dist": "electron-builder --linux deb --win nsis"
  },
  "devDependencies": {
    "electron": "^45.2.3",
    "electron-builder": "^26.18.0"
  },
  "build": {
    "appId": "com.wesley.agua",
    "productName": "Água",
    "publish": null,
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "main.html",
      "alert.html",
      "tray.png",
      "package.json"
    ],
    "linux": {
      "target": [
        "deb"
      ],
      "category": "Utility",
      "icon": "build/icon.png",
      "maintainer": "Wesley <agua@localhost>"
    },
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "runAfterFinish": false
    }
  },
  "homepage": "https://localhost",
  "author": {
    "name": "Wesley",
    "email": "agua@localhost"
  }
}
